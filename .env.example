# Copy to .env (`task init`) to override the defaults.

# Set by Compose; these are the defaults for `cargo run` / `task dev`.
# ALMENA_HOST=0.0.0.0
# ALMENA_PORT=8080
# ALMENA_KEYS_PATH=data/keys.json
# ALMENA_REDIS_URL=redis://localhost:6379   (memory:// keeps everything in the process)

# Public origin of the mediator (scheme://host[:port], no path). Its DID is the
# did:web of this origin, e.g. https://mediator.dev.almena.network ->
# did:web:mediator.dev.almena.network.
ALMENA_PUBLIC_URL=https://mediator.dev.almena.network

# Redis password, set on the Compose Redis and used by the mediator. Empty:
# no authentication (fine on a laptop, not on a server).
ALMENA_REDIS_PASSWORD=

# Largest DIDComm message accepted, in bytes.
ALMENA_MAX_MESSAGE_BYTES=1048576

# Mediation limits: queued messages expire after ALMENA_QUEUE_TTL seconds
# (30 days); at most ALMENA_QUEUE_MAX_MESSAGES queued, ALMENA_QUEUE_MAX_BYTES of
# them (100 MiB) and ALMENA_MAX_RECIPIENT_DIDS registered DIDs per mediation.
ALMENA_QUEUE_TTL=2592000
ALMENA_QUEUE_MAX_MESSAGES=10000
ALMENA_QUEUE_MAX_BYTES=104857600
ALMENA_MAX_RECIPIENT_DIDS=100
# Registering a DID other than the mediation's own needs a proof signed by
# that DID (an Almena extension to Coordinate Mediation): required or off.
ALMENA_RECIPIENT_PROOF=required
# A mediation whose wallet sends nothing for this many seconds (90 days) is
# removed with its DIDs, queue and devices; 0 keeps mediations forever.
ALMENA_MEDIATION_TTL=7776000

# POST /didcomm requests per minute per client IP (0 = no limit). Behind a
# reverse proxy, name the header that carries the client IP.
ALMENA_RATE_LIMIT=60
# ALMENA_CLIENT_IP_HEADER=x-forwarded-for

# Relay forwards to other mediators and resolve their did:web over HTTPS.
ALMENA_FEDERATION=true
# Allow plain HTTP and private addresses for outbound requests: only for
# running several mediators on one machine.
ALMENA_OUTBOUND_ALLOW_INSECURE=false

# Push wake-ups: off, or direct (the mediator calls FCM and APNs with the
# wallet app's credentials). At most one push per mediation until the wallet
# picks up, and never two within ALMENA_PUSH_MIN_INTERVAL seconds.
ALMENA_PUSH_MODE=off
ALMENA_PUSH_MIN_INTERVAL=60
# Paths as the mediator sees them (inside the container under Docker).
# ALMENA_FCM_SERVICE_ACCOUNT=/secrets/fcm-service-account.json
# ALMENA_APNS_KEY_PATH=/secrets/AuthKey.p8
# ALMENA_APNS_KEY_ID=
# ALMENA_APNS_TEAM_ID=
# ALMENA_APNS_TOPIC=
# ALMENA_APNS_SANDBOX=false

# Host ports published by Docker Compose.
ALMENA_MEDIATOR_PORT=8080
ALMENA_REDIS_PORT=6379

# Prometheus metrics on their own address (never through Caddy); unset: off.
# ALMENA_METRICS_ADDR=127.0.0.1:9090

ALMENA_LOG_FORMAT=json
RUST_LOG=info
