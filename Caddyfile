# HTTPS in front of the mediator for development, with a Let's Encrypt
# certificate: the wallet trusts only the public roots. The DNS-01 challenge is
# delegated to acme-dns (`task acme-dns`), so the machine need not be reachable.
mediator.dev.almena.network {
	tls {
		dns acmedns /secrets/acme-dns.json
	}
	reverse_proxy mediator:8080
}
